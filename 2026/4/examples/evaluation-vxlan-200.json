{
  "project": "chain-vxlan-eval-200",
  "remote_workdir": "/tmp/distributed-emulator",
  "emulation": {
    "quantization_ms": 10,
    "rule_mode": "host-veth-exact"
  },
  "time_inflation": {
    "factor": 4.0
  },
  "network": {
    "mode": "vxlan",
    "subnet": "10.43.0.0/16",
    "gateway": "10.43.0.1",
    "gateway_by_host": {
      "local-machine": "10.43.0.1",
      "remote-machine": "10.43.0.2"
    },
    "vxlan_id": 4243,
    "vxlan_port": 4789,
    "mtu": 1450
  },
  "peer_topology": {
    "type": "small-world",
    "seed": 2026,
    "local_degree": 2,
    "shortcut_probability": 0.35
  },
  "host_latency_policy": "subtract_from_emulated_delay",
  "host_latency_ms": {
    "local-machine->remote-machine": 1,
    "remote-machine->local-machine": 1
  },
  "ebpf": {
    "enabled": true,
    "mode": "tcp-rto",
    "auto_apply": false
  },
  "hosts": [
