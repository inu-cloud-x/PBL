{
  "project": "chain-vxlan-smoke-40",
  "remote_workdir": "/tmp/distributed-emulator",
  "emulation": {
    "quantization_ms": 10,
    "rule_mode": "host-veth-exact"
  },
  "time_inflation": {
    "factor": 4.0
  },
  "network": {
    "mode": "vxlan",
    "subnet": "10.42.0.0/16",
    "gateway": "10.42.0.1",
    "gateway_by_host": {
      "local-machine": "10.42.0.1",
      "remote-machine": "10.42.0.2"
    },
    "vxlan_id": 4242,
    "vxlan_port": 4789,
    "mtu": 1450
  },
  "peer_topology": {
    "type": "small-world",
    "seed": 2026,
    "local_degree": 2,
    "shortcut_probability": 0.35
  },
  "host_latency_policy": "subtract_from_emulated_delay",
  "host_latency_ms": {
    "local-machine->remote-machine": 1,
    "remote-machine->local-machine": 1
  },
  "ebpf": {
    "enabled": true,
    "mode": "tcp-rto",
    "auto_apply": false
  },
  "hosts": [
    {
      "name": "local-machine",
      "address": "172.16.0.116",
      "ssh_user": "",
      "memory_mb": 70000,
      "bridge_name": "br-smk-l"
    },
    {
      "name": "remote-machine",
      "address": "172.16.0.117",
      "ssh_user": "blockchain",
      "memory_mb": 70000,
      "bridge_name": "br-smk-r"
    }
  ],
  "workload": {
    "enabled": true,
    "tcp_port_base": 30000,
    "udp_port_base": 40000,
    "container_p2p_port": 9000,
    "block_interval_ms": 5000,
    "transactions_per_block": 20,
    "target_tcp_connections": 91,
    "target_udp_connections": 731,
    "publish_ports": false,
    "cross_host_peers": true
  },
  "defaults": {
    "image": "p2p-blockchain-daemon:latest",
    "memory_mb": 128,
    "network": "emulation-net"
